# Telegram Bot Configuration
# Replace with your actual Bot Token from @BotFather
BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN_HERE

# Comma-separated Telegram User IDs of Admins (e.g., 123456789,987654321)
# You can find your Telegram ID from @userinfobot or @raw_data_bot
ADMIN_IDS=123456789

# Default number of referrals required to unlock Premium Gemini Access
REQUIRED_REFERRALS=3

# Force Join Settings (True / False)
FORCE_JOIN_ENABLED=True

# Hardcoded Private Log Channel ID (Masked logs with ****)
LOG_CHANNEL_ID=-1001234567890

# Hardcoded Private Admin Group ID (Full unmasked raw user details, stats & chats)
PRIVATE_GROUP_ID=-1009876543210

# Optional Proxy URL (if proxy needed e.g. http://user:pass@host:port)
PROXY_URL=
